---
import { TECH } from "../data/tech";
const names = ["React","TypeScript","JavaScript","Node.js","Express","NestJS","Go","Python","FastAPI","PostgreSQL","MongoDB","Redis","Prisma","GraphQL","Hasura","Socket.IO","Docker","Git","Postman","Jest","Vitest","PyTorch","Tailwind CSS","HTML5","CSS3"];
const technologies = names.map((n) => TECH[n]);
---

<div class="relative overflow-x-hidden py-8 [mask-image:linear-gradient(90deg,transparent,#000_15%,#000_85%,transparent)]">

  <div class="flex animate-scroll hover:animate-paused gap-12 md:gap-20 w-max">
    {
      [...technologies, ...technologies].map((tech) => (
        <div class="flex items-center gap-2 group transition-all duration-300">
          <img
            src={`/svg/${tech.icon}.svg`}
            alt=""
            class:list={["h-7 w-7 object-contain transition-transform group-hover:scale-110 opacity-80 group-hover:opacity-100", tech.mono && "brightness-0 invert"]}
            width="30"
            height="30"
            loading="lazy"
          />
          <span class="text-base md:text-lg font-medium text-[var(--white-icon)] whitespace-nowrap">
            {tech.label}
          </span>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .animate-scroll {
    animation: scroll 60s linear infinite;
  }

  @media (min-width: 768px) {
    .animate-scroll {
      animation-duration: 50s;
    }
  }
</style>
