<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Let's talk</h2>
    <h3 class="text-4xl md:text-5xl font-semibold gradient-text w-fit mb-6">
      Contact
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <p class="mb-4">
          I'm open to software engineering roles, and to freelance projects. Send a note and I'll reply soon.
        </p>
        <div class="flex items-center gap-2 mb-2">
          <span>Email:</span>
          <a href="mailto:kabetomesay@gmail.com" class="text-[var(--white)] hover:text-[var(--sec)] transition break-all">kabetomesay@gmail.com</a>
        </div>
        <div class="flex items-center gap-2">
          <span>Location:</span>
          <span class="text-[var(--white)]">Addis Ababa, Ethiopia</span>
        </div>
      </div>

      <div>
        <form
          id="contact-form"
                    class="card flex flex-col gap-4 p-6 rounded-2xl"
        >
          <input
            type="text"
            name="name"
            placeholder="Name"
            required
            class="px-4 py-2 bg-[#0d0d0d99] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="email"
            name="email"
            placeholder="Email"
            required
            class="px-4 py-2 bg-[#0d0d0d99] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <textarea
            name="message"
            placeholder="Message"
            rows="6"
            required
            class="px-4 py-2 bg-[#0d0d0d99] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
          ></textarea>
          <button
            type="submit"
            class="px-4 py-3 rounded-lg bg-[var(--sec)] text-[var(--background)] font-medium hover:opacity-90 transition"
          >
            Submit
          </button>
        </form>
        <div
          id="form-message"
          class="hidden justify-center items-center mt-4 text-[var(--white)] text-lg"
        >
          ✅ Your email client will open to send the message.
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module" is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const body = `${d.get("message")}\n\n${d.get("name")} (${d.get("email")})`;
    const url = `mailto:kabetomesay@gmail.com?subject=${encodeURIComponent("Portfolio message from " + d.get("name"))}&body=${encodeURIComponent(body)}`;
    formMessage.classList.remove("hidden");
    formMessage.classList.add("flex");
    setTimeout(() => { window.location.href = url; }, 600);
  });
</script>
